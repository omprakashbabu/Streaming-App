# MongoDB Connection
#MONGODB_URI=mongodb://localhost:27017/video-streaming

MONGODB_URI=mongodb:yourmongouri

# JWT Secret (I changed this to something random)
JWT_SECRET=myjwtsecretkey

# Server Port
PORT=myport

# AWS S3 Configuration (filled after creating AWS account)
AWS_ACCESS_KEY_ID=myawsaccesskey


AWS_REGION=myregion
S3_BUCKET_NAME=mybucketname

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123